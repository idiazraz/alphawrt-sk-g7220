/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/phy/phy.h>
#include "an7581.dtsi"
#include "an7581-npu-mt7992.dtsi"

/ {
	model = "Skyworth SK-G7220 :  7581";
	compatible = "skyworth,sk-g7220", "airoha,an7581", "airoha,en7581";

	aliases {
		serial0 = &uart1;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		bootargs-append = " rootfstype=squashfs";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x40000000>;
	};

	keys {
		compatible = "gpio-keys";

		key-restart {
			label = "reset";
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		key-wps {
			label = "wps";
			gpios = <&en7581_pinctrl 22 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-1 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 18 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_FAULT;
			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
		};

		led-3 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
		};

		led-4 {
			color = <LED_COLOR_ID_GREEN>;
			function = "voip";
			gpios = <&en7581_pinctrl 23 GPIO_ACTIVE_LOW>;
		};

		led-5 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&en7581_pinctrl 25 GPIO_ACTIVE_LOW>;
		};

		led-6 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			gpios = <&en7581_pinctrl 27 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "usbport";
			trigger-sources = <&usb_port1>;
		};
	};
};

&en7581_pinctrl {
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};

		conf {
			pins = "gpio2";
			output-high;
		};
	};

	pcie0_rst_pins: pcie0-rst-pins {
		conf {
			pins = "pcie_reset0";
			drive-open-drain = <1>;
		};
	};

	pcie1_rst_pins: pcie1-rst-pins {
		conf {
			pins = "pcie_reset1";
			drive-open-drain = <1>;
		};
	};
};

&snfi {
	status = "okay";
};

&spi_nand {
	#address-cells = <1>;
	#size-cells = <1>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x00000000 0x00080000>;
			read-only;
		};

		partition@80000 {
			label = "tclinux";
			reg = <0x00080000 0x03c00000>;
		};

		kernel@80000,0 {
			label = "kernel";
			reg = <0x00080000 0x00400000>;
		};

		rootfs@480000 {
			label = "rootfs";
			reg = <0x00480000 0x03800000>;
		};

		partition@3c80000 {
			label = "tclinux_slave";
			reg = <0x03c80000 0x03c00000>;
		};

		kernel_slave@3c80000,0 {
			label = "kernel_slave";
			reg = <0x03c80000 0x00400000>;
		};

		rootfs_slave@4080000 {
			label = "rootfs_slave";
			reg = <0x04080000 0x03800000>;
		};

		partition@7880000 {
			label = "rootfs_data";
			reg = <0x07880000 0x00800000>;
		};

		partition@8080000 {
			label = "ubifs";
			reg = <0x08080000 0x02000000>;
		};

		partition@a080000 {
			label = "others";
			reg = <0x0a080000 0x00200000>;
		};

		art: partition@dc80000 {
			label = "art";
			reg = <0x0dc80000 0x00380000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				base_mac: macaddr@0 {
					compatible = "mac-base";
					reg = <0x0 0x11>;
					#nvmem-cell-cells = <1>;
				};

				eeprom_mt7992: eeprom@40000 {
					reg = <0x40000 0x15c000>;
				};
			};
		};

		/* Reserved for bad block management pool */
		reserved_bmt@e000000 {
			label = "reserved_bmt";
			reg = <0x0e000000 0x02000000>;
			read-only;
		};
	};
};

&mdio {
	/* Airoha EN8811H 2.5Gbps PHY */
	en8811: ethernet-phy@f {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <0xf>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
				default-state = "keep";
			};
		};
	};
};

&eth {
	status = "okay";
};

/* Internal 10G link to the switch: the DSA conduit for lan2-4 */
&gdm1 {
	status = "okay";

	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac (0)>;
};

&switch {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
};

&gsw_port2 {
	status = "okay";
	label = "lan2";
};

&gsw_phy2 {
	status = "okay";
	interrupts = <2>;
};

&gsw_port3 {
	status = "okay";
	label = "lan3";
};

&gsw_phy3 {
	status = "okay";
	interrupts = <3>;
};

&gsw_port4 {
	status = "okay";
	label = "lan4";
};

&gsw_phy4 {
	status = "okay";
	interrupts = <4>;
};

&gdm4 {
	status = "okay";
	openwrt,netdev-name = "lan1";

	phy-handle = <&en8811>;
	phy-mode = "2500base-x";

	nvmem-cell-names = "mac-address";
	nvmem-cells = <&base_mac (0)>;
};

/* MT7992 second PCIe function (hif2) */
&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_rst_pins>;
	status = "okay";

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;
		};
	};
};

/* MT7992 main function: owns the calibration data */
&pcie1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_rst_pins>;
	status = "okay";

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;
			nvmem-cells = <&eeprom_mt7992>, <&base_mac (2)>;
			nvmem-cell-names = "eeprom", "mac-address";
		};
	};
};

&usb0 {
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	usb_port1: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};
};
