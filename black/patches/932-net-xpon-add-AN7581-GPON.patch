From: idiazraz <100824525+idiazraz@users.noreply.github.com>
Subject: [PATCH] net: xpon: add AN7581 GPON

Port Sirherobrine23's "net: xpon: introduce an7581 and an7583 and split xpon
phy" (airoha/kernel e1001b06f5) to this tree. It splits the xPON PHY into
drivers/phy/airoha/xpon/ and adds the AN7581 PHY backend, the AN7581 xPON MAC
data and the GDM2 datapath changes. His ToD commit is left out.

The AN7581 PHY reset is only pulsed here, never held: his driver left it
asserted from probe, and the first PMA access in power-on then hung the board.
The digital block is also left alone until the init sequence has run.
XPON_INT_ENABLE is never written, because that resets the board, and the TX
PLL lock is only reported, because the bit stays low with no fibre.
The PHY setup writes move after the RX tables, which release the digital reset.

diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 4928bb9..c78835a 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -2423,10 +2423,11 @@ airoha_qdma_rx_frame_desc(struct airoha_queue *q,
 			  struct airoha_qdma_desc *desc,
 			  struct airoha_qdma_desc *frame_desc)
 {
-	if (!airoha_is(q->qdma->eth, econet_en7580))
+	if (!airoha_is(q->qdma->eth, econet_en7580, airoha_en7581,
+		       airoha_an7583))
 		return desc;
 
-	/* EN7580 continuation descriptors can have a different SPORT and tag.
+	/* Continuation descriptors can have a different SPORT and tag.
 	 * Save the first descriptor's metadata across polls and ring refills.
 	 */
 	if (!q->skb) {
@@ -2490,7 +2491,7 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 
 		desc = airoha_qdma_rx_frame_desc(q, desc, &frame_desc);
 		msg0 = le32_to_cpu(READ_ONCE(desc->msg0));
-		if (airoha_is(eth, airoha_en7523) &&
+		if (eth->soc->gpon_metadata &&
 		    q - &q->qdma->q_rx[0] == 15) {
 			u32 msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
 			u32 msg3 = le32_to_cpu(READ_ONCE(desc->msg3));
@@ -2506,7 +2507,7 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 					     channel, gem_port_id,
 					     !!(msg0 & EN7523_QDMA_ETH_RXMSG_NO_MIC_MASK));
 		}
-		xpon_oam = airoha_is(eth, airoha_en7523) &&
+		xpon_oam = eth->soc->gpon_metadata &&
 			   (msg0 & EN7523_QDMA_ETH_RXMSG_OAM_MASK);
 
 		/* GPON OAM descriptors are not required to carry an Ethernet
@@ -2548,7 +2549,7 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 		if (FIELD_GET(QDMA_DESC_MORE_MASK, desc_ctrl))
 			continue;
 
-		if (airoha_is(eth, airoha_en7523)) {
+		if (eth->soc->gpon_metadata) {
 			struct airoha_xpon_oam_handler *handler;
 
 			if (xpon_oam) {
@@ -2761,7 +2762,8 @@ static int airoha_qdma_init_rx_queue(struct airoha_queue *q,
 			FIELD_PREP(RX_RING_THR_MASK, thr));
 	airoha_qdma_rmw(qdma, REG_RX_DMA_IDX(qid), RX_RING_DMA_IDX_MASK,
 			FIELD_PREP(RX_RING_DMA_IDX_MASK, q->head));
-	if (lro_q || (airoha_is(eth, airoha_en7523) && qid == 15))
+	if (lro_q || (airoha_is(eth, airoha_en7523, airoha_en7581,
+				airoha_an7583) && qid == 15))
 		airoha_qdma_clear(qdma, REG_RX_SCATTER_CFG(qid),
 				  RX_RING_SG_EN_MASK);
 	else
@@ -5439,7 +5441,7 @@ static int airoha_validate_xpon_gdm2(struct net_device *netdev,
 	 * netdev.
 	 */
 	if (common->family == AIROHA_ETH_FAMILY_AIROHA) {
-		if (!airoha_is(common->eth, airoha_en7523))
+		if (!common->eth->soc->gpon_metadata)
 			return -EOPNOTSUPP;
 	} else if (common->family == AIROHA_ETH_FAMILY_ECONET) {
 		if (!airoha_is(common->eth, econet_en7528))
@@ -5501,6 +5503,9 @@ static int airoha_xpon_set_mode(struct net_device *netdev,
 	if (mode != AIROHA_XPON_MODE_GPON &&
 	    mode != AIROHA_XPON_MODE_EPON)
 		return -EINVAL;
+	if (airoha_is(dev->eth, airoha_en7581, airoha_an7583) &&
+	    mode != AIROHA_XPON_MODE_GPON)
+		return -EOPNOTSUPP;
 
 	/* FE_API_SET_GDMA_MISC_CONFIG(FE_GDM_SEL_GDMA2, mode).
 	 * The vendor SDK sets GDMA2_RLS_MODE only for GPON.
@@ -5539,7 +5544,8 @@ static int airoha_xpon_set_mode(struct net_device *netdev,
 	 * eventually stops releasing frames towards GDM2 and transmit stalls
 	 * permanently, with no completion, no drop and no error reported.
 	 */
-	if (airoha_is(dev->eth, airoha_en7523) &&
+	if (airoha_is(dev->eth, airoha_en7523, airoha_en7581,
+		      airoha_an7583) &&
 	    mode == AIROHA_XPON_MODE_GPON)
 		airoha_qdma_set(&dev->eth->qdma[1], REG_PSE_BUF_USAGE_CFG,
 				PSE_BUF_ESTIMATE_EN_MASK);
@@ -6609,7 +6615,7 @@ static int airoha_fe_init(struct airoha_eth *eth)
 	 * Without this, the upstream transmits runt frames which are
 	 * discarded by the OLT or the peer.
 	 */
-	if (airoha_is(eth, airoha_en7523))
+	if (eth->soc->gpon_metadata)
 		airoha_fe_set(eth, REG_GDM_FWD_CFG(AIROHA_GDM2_IDX),
 			      GDM_PAD_EN_MASK);
 
@@ -7801,7 +7807,14 @@ static u8 airoha_skb_ip_version(const struct sk_buff *skb)
 	return data ? *data >> 4 : 0;
 }
 
-static u32 airoha_qdma_tx_csum_flags(const struct sk_buff *skb)
+static u32 airoha_qdma_tx_ico_mask(struct airoha_eth *eth)
+{
+	return airoha_is(eth, airoha_an7583) ? AN7583_QDMA_ETH_TXMSG_ICO_MASK :
+					    QDMA_ETH_TXMSG_ICO_MASK;
+}
+
+static u32 airoha_qdma_tx_csum_flags(struct airoha_eth *eth,
+				     const struct sk_buff *skb)
 {
 	u32 flags = 0;
 
@@ -7809,14 +7822,16 @@ static u32 airoha_qdma_tx_csum_flags(const struct sk_buff *skb)
 		return 0;
 
 	if (airoha_skb_ip_version(skb) == 4)
-		flags |= QDMA_ETH_TXMSG_ICO_MASK;
+		flags |= airoha_qdma_tx_ico_mask(eth);
 
 	switch (skb->csum_offset) {
 	case offsetof(struct tcphdr, check):
 		flags |= QDMA_ETH_TXMSG_TCO_MASK;
 		break;
 	case offsetof(struct udphdr, check):
-		flags |= QDMA_ETH_TXMSG_UCO_MASK;
+		/* AN7583 shares the TCP/UDP checksum request in bit 11. */
+		flags |= airoha_is(eth, airoha_an7583) ?
+			 AN7583_QDMA_ETH_TXMSG_TUCO_MASK : QDMA_ETH_TXMSG_UCO_MASK;
 		break;
 	}
 
@@ -7960,7 +7975,7 @@ static netdev_tx_t __airoha_dev_xmit(struct sk_buff *skb,
 	qid = airoha_qdma_get_txq(qdma, xpon ? xpon->queue :
 				    skb_get_queue_mapping(skb));
 	if (xpon) {
-		if (!airoha_is(qdma->eth, airoha_en7523))
+		if (!qdma->eth->soc->gpon_metadata)
 			goto error;
 
 		msg0 = FIELD_PREP(QDMA_ETH_TXMSG_QUEUE_MASK, xpon->queue) |
@@ -7998,7 +8013,7 @@ static netdev_tx_t __airoha_dev_xmit(struct sk_buff *skb,
 		       FIELD_PREP(QDMA_ETH_TXMSG_SP_TAG_MASK, tag);
 	}
 	if (!xpon_oam)
-		msg0 |= airoha_qdma_tx_csum_flags(skb);
+		msg0 |= airoha_qdma_tx_csum_flags(qdma->eth, skb);
 
 	/* TSO: fill MSS info in tcp checksum field */
 	if (!xpon_oam && skb_is_gso(skb)) {
@@ -8013,7 +8028,7 @@ static netdev_tx_t __airoha_dev_xmit(struct sk_buff *skb,
 			msg0 |= QDMA_ETH_TXMSG_TCO_MASK |
 				QDMA_ETH_TXMSG_TSO_MASK;
 			if (skb_shinfo(skb)->gso_type & SKB_GSO_TCPV4)
-				msg0 |= QDMA_ETH_TXMSG_ICO_MASK;
+				msg0 |= airoha_qdma_tx_ico_mask(qdma->eth);
 		}
 	}
 
@@ -8033,6 +8048,9 @@ static netdev_tx_t __airoha_dev_xmit(struct sk_buff *skb,
 		       FIELD_PREP(QDMA_ETH_TXMSG_METER_MASK, 0x7f);
 	}
 
+	if (xpon && airoha_is(qdma->eth, airoha_en7581))
+		msg1 |= GENMASK(10, 0);
+
 	if (xpon_oam)
 		msg1 |= QDMA_ETH_TXMSG_NO_DROP;
 
@@ -10080,6 +10098,8 @@ static int airoha_en7581_get_sport(struct airoha_gdm_port *port, int nbq)
 static u32 airoha_en7581_get_vip_port(struct airoha_gdm_port *port, int nbq)
 {
 	switch (port->id) {
+	case AIROHA_GDM2_IDX:
+		return BIT(AIROHA_GDM2_IDX);
 	case AIROHA_GDM3_IDX:
 		if (nbq == 4)
 			return XSI_PCIE0_VIP_PORT_MASK;
@@ -10162,6 +10182,8 @@ static int airoha_an7583_get_sport(struct airoha_gdm_port *port, int nbq)
 static u32 airoha_an7583_get_vip_port(struct airoha_gdm_port *port, int nbq)
 {
 	switch (port->id) {
+	case AIROHA_GDM2_IDX:
+		return BIT(AIROHA_GDM2_IDX);
 	case AIROHA_GDM3_IDX:
 		if (!nbq)
 			return XSI_ETH_VIP_PORT_MASK;
@@ -10350,6 +10372,8 @@ const struct airoha_eth_soc_data econet_en7580_soc_data = {
 
 const struct airoha_eth_soc_data airoha_en7581_soc_data = {
 	.version = airoha_en7581,
+	.xpon_ops = &airoha_xpon_ops,
+	.gpon_metadata = true,
 	.xsi_rsts_names = en7581_xsi_rsts_names,
 	.num_xsi_rsts = ARRAY_SIZE(en7581_xsi_rsts_names),
 	.num_ppe = 2,
@@ -10393,6 +10417,7 @@ const struct airoha_eth_soc_data airoha_an7583_soc_data = {
 const struct airoha_eth_soc_data airoha_en7523_soc_data = {
 	.version = airoha_en7523,
 	.xpon_ops = &airoha_xpon_ops,
+	.gpon_metadata = true,
 	.xsi_rsts_names = en7523_xsi_rsts_names,
 	.num_xsi_rsts = ARRAY_SIZE(en7523_xsi_rsts_names),
 	.rx_ring = 16,
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
index 156f5a8..a98d2d6 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.h
+++ b/drivers/net/ethernet/airoha/airoha_eth.h
@@ -1275,6 +1275,8 @@ struct airoha_eth_soc_data {
 	int irq_banks;
 	int max_gdm_ports;
 	bool legacy_qdma;
+	/* GPON word 0 metadata; word 1 retains the SoC-specific RX layout. */
+	bool gpon_metadata;
 	bool ppe_datapath;
 	u32 pse_fq_cfg;
 	u32 ppe_stats_entries;
diff --git a/drivers/net/ethernet/airoha/airoha_regs.h b/drivers/net/ethernet/airoha/airoha_regs.h
index e760381..e4223c9 100644
--- a/drivers/net/ethernet/airoha/airoha_regs.h
+++ b/drivers/net/ethernet/airoha/airoha_regs.h
@@ -1024,6 +1024,10 @@
 /* TX MSG0 */
 #define QDMA_ETH_TXMSG_MIC_IDX_MASK	BIT(30)
 #define QDMA_ETH_TXMSG_SP_TAG_MASK	GENMASK(29, 14)
+/* AN7583 repurposes bit 13 for padding and shares TCP/UDP checksum. */
+#define AN7583_QDMA_ETH_TXMSG_PAD_MASK	BIT(13)
+#define AN7583_QDMA_ETH_TXMSG_ICO_MASK	BIT(12)
+#define AN7583_QDMA_ETH_TXMSG_TUCO_MASK	BIT(11)
 #define QDMA_ETH_TXMSG_ICO_MASK		BIT(13)
 #define QDMA_ETH_TXMSG_UCO_MASK		BIT(12)
 #define QDMA_ETH_TXMSG_TCO_MASK		BIT(11)
diff --git a/drivers/net/ethernet/airoha/airoha_xpon.c b/drivers/net/ethernet/airoha/airoha_xpon.c
index 800bc09..80b0e9a 100644
--- a/drivers/net/ethernet/airoha/airoha_xpon.c
+++ b/drivers/net/ethernet/airoha/airoha_xpon.c
@@ -597,7 +597,7 @@ static int gpon_prepare_hardware(struct xpon_priv *priv)
 	 * additional DBA/BWmap defaults.  EN7528 also starts from the vendor
 	 * 0x4208 reset image, but does not use the EN7523 DBA/BWmap defaults.
 	 */
-	if (priv->match_data->en7523_gpon_defaults ||
+	if (priv->match_data->gpon_defaults ||
 	    priv->match_data->gpon_reset_dbg_dly)
 		gpon_write(priv, GPON_DBG_DLY, DBG_DLY_RESET_DEFAULT);
 	gpon_rmw(priv, GPON_DBG_DLY, DBG_DLY_FINE_INT_MASK,
@@ -606,12 +606,13 @@ static int gpon_prepare_hardware(struct xpon_priv *priv)
 	gpon_rmw(priv, GPON_DBG_IDLE_GEM_THLD, GENMASK(15, 0),
 		 priv->match_data->gpon_idle_gem_threshold);
 
-	if (priv->match_data->en7523_gpon_defaults) {
+	if (priv->match_data->gpon_defaults ||
+	    priv->match_data->gpon_dbru_48b)
 		gpon_rmw(priv, GPON_GBL_CFG, GBL_CFG_SR_BLK_SIZE_MASK,
 			 GPON_DBRU_BLOCK_SIZE_48B);
+	if (priv->match_data->gpon_defaults)
 		gpon_clear_bits(priv, GPON_DBG_BWM_FILTER_CTRL,
 				BWM_FILTER_LEN_VALID_CHECK_EN);
-	}
 
 	mbi = gpon_read(priv, GPON_MBI_MPI_STOP);
 	if (priv->match_data->gpon_has_mpi)
@@ -2291,6 +2292,8 @@ static void gpon_cb_state_changed(void *hw_priv, enum gpon_state state)
 				 msecs_to_jiffies(GPON_TO1_MS));
 		break;
 	case GPON_O5_OPERATION:
+		if (priv->match_data->gpon_has_del_rx_stop)
+			gpon_clear_bits(priv, GPON_MBI_MPI_STOP, DEL_RX_STOP);
 		/* Cancel TO1 and start periodic BER reporting only in O5. */
 		cancel_delayed_work(&priv->to1_work);
 		if (priv->ber_interval_ms)
@@ -2489,13 +2492,14 @@ static int gpon_enable(struct xpon_priv *priv)
 	 * them continuously while GEM delineation is being acquired; counters
 	 * remain available through the diagnostic paths.
 	 */
-	irq_mask = GPON_INT_DEFAULT_MASK;
+	irq_mask = priv->match_data->gpon_irq_mask ?: GPON_INT_DEFAULT_MASK;
+	known = irq_mask;
 	if (priv->dying_gasp_irq >= 0)
 		irq_mask &= ~INT_DYING_GASP;
 
 	pending = gpon_read(priv, GPON_INT_STATUS);
-	known = pending & (u32)GPON_INT_DEFAULT_MASK;
-	unknown = pending & ~(u32)GPON_INT_DEFAULT_MASK;
+	unknown = pending & ~known;
+	known &= pending;
 	fifo_depth = gpon_read(priv, GPON_PLOAMd_FIFO_STS) &
 		     PLOAMd_FIFO_USED_MASK;
 	if (pending || fifo_depth)
@@ -4635,7 +4639,7 @@ static const struct airoha_xpon_match_data en7523_xpon_data = {
 	.gpon_fine_delay = DBG_DLY_FINE_INT_DEFAULT,
 	.gpon_rsp_time_activation = GPON_RSP_TIME_ACT_EN7523,
 	.gpon_idle_gem_threshold = GPON_IDLE_GEM_THLD_EN7523,
-	.en7523_gpon_defaults = true,
+	.gpon_defaults = true,
 	.gpon_reset_on_start = true,
 };
 
@@ -4676,7 +4680,24 @@ static const struct airoha_xpon_match_data en7528_xpon_data = {
 	.scu_dying_gasp_status = true,
 };
 
+/* AN7581 uses the 1G GPON MAC with its own PCS/PMA PHY backend. */
+static const struct airoha_xpon_match_data an7581_xpon_data = {
+	.version = airoha_en7581,
+	.wan_mode_mask = EN7523_SCU_WAN_MODE_MASK,
+	.gpon_fine_delay = DBG_DLY_FINE_INT_DEFAULT,
+	.gpon_rsp_time_activation = GPON_RSP_TIME_ACT_EN7523,
+	.gpon_idle_gem_threshold = GPON_IDLE_GEM_THLD_EN7523,
+	/* Bit 15 reports a zero grant on AN7581, not grant calculation done. */
+	.gpon_irq_mask = GPON_INT_DEFAULT_MASK & ~INT_CAL_GNT_SIZE_DONE,
+	.gpon_dbru_48b = true,
+	.gpon_has_del_rx_stop = true,
+	.gpon_reset_on_start = true,
+	.gpon_rearm_tx_on_overhead = true,
+	.scu_dying_gasp_status = true,
+};
+
 static const struct of_device_id airoha_xpon_of_match[] = {
+	{ .compatible = "airoha,an7581-xpon", .data = &an7581_xpon_data },
 	{ .compatible = "airoha,en7523-xpon", .data = &en7523_xpon_data },
 	{ .compatible = "airoha,en751627-xpon", .data = &en7528_xpon_data },
 	{ .compatible = "airoha,en7528-xpon", .data = &en7528_xpon_data },
diff --git a/drivers/net/ethernet/airoha/airoha_xpon.h b/drivers/net/ethernet/airoha/airoha_xpon.h
index 80485d4..b08b6ad 100644
--- a/drivers/net/ethernet/airoha/airoha_xpon.h
+++ b/drivers/net/ethernet/airoha/airoha_xpon.h
@@ -36,12 +36,15 @@ struct airoha_xpon_match_data {
 	enum airoha_ids version;
 	bool mode_from_dt;
 	u32 wan_mode_mask;
+	u32 gpon_irq_mask;
 	u8 gpon_fine_delay;
 	u16 gpon_rsp_time_activation;
 	u16 gpon_idle_gem_threshold;
 	u8 gpon_guard_bits_override;
 	u8 gpon_sn_tx_power_mode;
-	bool en7523_gpon_defaults;
+	bool gpon_defaults;
+	bool gpon_dbru_48b;
+	bool gpon_has_del_rx_stop;
 	bool gpon_reset_dbg_dly;
 	bool mac_irq_via_eth;
 	bool gpon_adjust_rx_delay;
@@ -269,6 +272,7 @@ struct airoha_xpon_match_data {
 
 /* G_MBI_MPI_STOP */
 #define MBI_RX_STOP		BIT(0)
+#define DEL_RX_STOP		BIT(4)
 #define MBI_TX_STOP		BIT(8)
 #define MPI_RX_STOP		BIT(16)
 #define MPI_TX_STOP		BIT(24)
diff --git a/drivers/phy/airoha/Kconfig b/drivers/phy/airoha/Kconfig
