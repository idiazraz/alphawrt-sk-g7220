-	if (!phy || !ready || !los)
-		return -EINVAL;
-
-	priv = phy_get_drvdata(phy);
-	if (!priv)
-		return -ENODEV;
-
-	if (!READ_ONCE(priv->powered)) {
-		*ready = false;
-		*los = true;
-		return 0;
-	}
-
-	*ready = airoha_xpon_phy_ready(priv);
-	*los = airoha_xpon_phy_los(priv);
