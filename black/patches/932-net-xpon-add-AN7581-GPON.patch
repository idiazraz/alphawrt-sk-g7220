-	mask = XPON_GPON_EXT_O3_O4_MASK | XPON_GPON_EXT_O5_MASK |
-	       XPON_GPON_EXT_MODE | XPON_GPON_EXT_OPER_MASK;
-	val = FIELD_PREP(XPON_GPON_EXT_O3_O4_MASK, o3_o4_preamble) |
-	      FIELD_PREP(XPON_GPON_EXT_O5_MASK, o5_preamble) |
