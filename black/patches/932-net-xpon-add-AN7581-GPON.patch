index 0000000..5ae651b
--- /dev/null
+++ b/drivers/phy/airoha/xpon/Kconfig
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# PHY drivers for the xPON family
+#
+config PHY_AIROHA_XPON
+	tristate "Airoha/EcoNet xPON PHY driver"
+	depends on ARCH_AIROHA || ECONET || COMPILE_TEST
+	depends on OF
+	depends on MFD_SYSCON
+	select GENERIC_PHY
+	help
+	  Enable the shared digital PHY API and provider infrastructure used by
+	  the EcoNet and Airoha GPON, EPON and XGS-PON backends.
+
+if PHY_AIROHA_XPON
+
+config PHY_AIROHA_XPON_EN751221
+	tristate "xPON PHY for EN751221"
+	default y
+	depends on PHY_AIROHA_XPON
+	depends on ECONET || COMPILE_TEST
+
+config PHY_AIROHA_XPON_EN7528
+	tristate "xPON PHY for EN7528 and EN751627"
+	default y
+	depends on PHY_AIROHA_XPON
+	depends on ECONET || COMPILE_TEST
+
+config PHY_AIROHA_XPON_EN7580
+	tristate "XGS-PON PHY for EN7580"
+	default y
+	depends on PHY_AIROHA_XPON
+	depends on ECONET || COMPILE_TEST
+
+config PHY_AIROHA_XPON_EN7523
+	tristate "xPON PHY for EN7523"
+	default y
+	depends on PHY_AIROHA_XPON
+	depends on ARCH_AIROHA || COMPILE_TEST
+
+config PHY_AIROHA_XPON_AN7581
+	tristate "GPON PHY for AN7581"
+	default y
+	depends on PHY_AIROHA_XPON
+	depends on ARCH_AIROHA || COMPILE_TEST
+
+config PHY_AIROHA_XPON_AN7583
+	tristate "xPON PHY for AN7583"
+	depends on BROKEN
+	default y
+	depends on PHY_AIROHA_XPON
+	depends on ARCH_AIROHA || COMPILE_TEST
+
+config PHY_AIROHA_XPON_AN7552
+	tristate "xPON PHY for AN7552"
+	default y
+	depends on PHY_AIROHA_XPON
+	depends on ARCH_AIROHA || COMPILE_TEST
+
+endif
