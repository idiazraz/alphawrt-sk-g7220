-		 stage, priv->soc->name,
-		 priv->submode == AIROHA_XPON_PHY_SUBMODE_GPON ?
-		 "GPON" : "EPON",
-		 airoha_xpon_phy_ready(priv), airoha_xpon_phy_los(priv),
