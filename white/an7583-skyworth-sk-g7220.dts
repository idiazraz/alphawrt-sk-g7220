// SPDX-License-Identifier: GPL-2.0-only OR MIT
/*
 * Device Tree for Skyworth SK-G7220 (Airoha AN7553 / AN7583)
 *
 * Hardware features:
 * - SoC: Airoha AN7553 (2x Cortex-A53 @ 1.2GHz, 512 MiB RAM)
 * - Flash: Foresee F35SQB002G SPI-NAND (256 MiB)
 * - Ethernet:
 *   - 2.5G WAN: Airoha EN8811H PHY 14 (MDIO 0x0e) on gdm2 (2500base-x)
 *   - 2.5G LAN1: Airoha EN8811H PHY 15 (MDIO 0x0f) on gdm3 (2500base-x)
 *   - 1G LAN2-4: Internal switch ports 2, 3, 4 (gsw_port2-4)
 * - Wi-Fi 7: MediaTek MT7992 (BE6500)
 *   - Main radio: PCIe Gen3 (pcie1)
 *   - HIF2: PCIe Gen2 (pcie0)
 *   - Calibration: art partition offset 0x40000
 * - LEDs: Power (GPIO 7), PON (GPIO 12), LOS (GPIO 27), Internet (GPIO 26),
 *         VoIP (GPIO 29), Wi-Fi (GPIO 33), USB (GPIO 38)
 * - Buttons: Reset (GPIO 0), WPS (GPIO 5)
 */

/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "an7583.dtsi"

/ {
	model = "Skyworth SK-G7220";
	compatible = "skyworth,sk-g7220", "airoha,an7583";

	aliases {
		serial0 = &uart1;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
		linux,usable-memory-range = <0x0 0x80200000 0x0 0x1fe00000>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-restart {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		button-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 5 GPIO_ACTIVE_HIGH>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&pinctrl 7 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-1 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&pinctrl 12 GPIO_ACTIVE_LOW>;
		};

		led-2 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_FAULT;
			gpios = <&pinctrl 27 GPIO_ACTIVE_LOW>;
		};

		led-3 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
		};

		led-4 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&pinctrl 29 GPIO_ACTIVE_LOW>;
		};

		led-5 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&pinctrl 33 GPIO_ACTIVE_LOW>;
		};

		led-6 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			gpios = <&pinctrl 38 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "usbport";
			trigger-sources = <&usb_port1>, <&usb_port2>;
		};
	};
};

&pinctrl {
	gpio-ranges = <&pinctrl 0 2 53>;

	mdio0_pins: mdio0-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};
		conf {
			pins = "mdio_0";
			output-high;
		};
	};

	spi_pins: spi-pins {
		mux {
			function = "spi";
			groups = "spi";
		};
	};

	pcie0_rst_pins: pcie0-rst-pins {
		conf {
			pins = "pcie_reset0";
			drive-open-drain = <1>;
		};
	};

	pcie1_rst_pins: pcie1-rst-pins {
		conf {
			pins = "pcie_reset1";
			drive-open-drain = <1>;
		};
	};

	gswp2_led0_pins: gswp2-led0-pins {
		mux {
			function = "phy2_led0";
			pins = "gpio2";
		};
	};

	gswp3_led0_pins: gswp3-led0-pins {
		mux {
			function = "phy3_led0";
			pins = "gpio3";
		};
	};

	gswp4_led0_pins: gswp4-led0-pins {
		mux {
			function = "phy4_led0";
			pins = "gpio4";
		};
	};
};

&snfi {
	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins>;
	status = "okay";
};

&spi_nand {
	/* Foresee F35SQB002G, 256 MiB, 2 KiB pages, 128 KiB blocks */
	nand-ecc-mode = "none";
	nand-ecc-step-size = <2048>;
	nand-ecc-strength = <0>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x80000>;
			read-only;
		};

		partition@80000 {
			label = "kernel";
			reg = <0x80000 0x700000>;
		};

		partition@780000 {
			label = "filesystem";
			reg = <0x780000 0x4400000>;
		};

		partition@4b80000 {
			label = "kernel_slave";
			reg = <0x4b80000 0x700000>;
		};

		partition@5280000 {
			label = "filesystem_slave";
			reg = <0x5280000 0x4400000>;
		};

		partition@9680000 {
			label = "rootfs_data";
			reg = <0x9680000 0x800000>;
		};

		partition@9e80000 {
			label = "ubifs";
			reg = <0x9e80000 0x2000000>;
		};

		partition@be80000 {
			label = "others";
			reg = <0xbe80000 0x200000>;
			read-only;
		};

		art: partition@dc80000 {
			label = "art";
			reg = <0xdc80000 0x380000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				macaddr_art_0: macaddr@0 {
					reg = <0x0 0x11>;
				};

				cal_art_40000: cal@40000 {
					reg = <0x40000 0x15c000>;
				};
			};
		};
	};
};

&eth {
	status = "okay";
};

&eth_pcs {
	status = "okay";
};

&pon_pcs {
	status = "okay";
};

&i2c0 {
	/* EN7571 BOSA */
	status = "okay";
};

&switch {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mdio0_pins>;
};

&gsw_port2 {
	status = "okay";
	label = "lan2";
};

&gsw_phy2 {
	status = "okay";
	interrupts = <2>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp2_led0_pins>;
};

&gsw_phy2_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
	active-low;
};

&gsw_port3 {
	status = "okay";
	label = "lan3";
};

&gsw_phy3 {
	status = "okay";
	interrupts = <3>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp3_led0_pins>;
};

&gsw_phy3_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
	active-low;
};

&gsw_port4 {
	status = "okay";
	label = "lan4";
};

&gsw_phy4 {
	status = "okay";
	interrupts = <4>;
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp4_led0_pins>;
};

&gsw_phy4_led0 {
	status = "okay";
	color = <LED_COLOR_ID_GREEN>;
	active-low;
};

&mdio_0 {
	#address-cells = <1>;
	#size-cells = <0>;

	en8811_wan: ethernet-phy@e {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <0xe>;
	};

	en8811_lan: ethernet-phy@f {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <0xf>;
	};
};

&gdm1 {
	status = "okay";
};

&gdm2 {
	status = "okay";
	openwrt,netdev-name = "wan";
	phy-handle = <&en8811_wan>;
	phy-mode = "2500base-x";
};

&gdm3 {
	status = "okay";
	openwrt,netdev-name = "lan1";
	phy-handle = <&en8811_lan>;
	phy-mode = "2500base-x";
};

&usb_phy {
	status = "okay";
};

&usb0 {
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	usb_port1: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};

	usb_port2: port@2 {
		reg = <2>;
		#trigger-source-cells = <0>;
	};
};

/ {
	soc {
		pciephy: phy@1fc7f000 {
			compatible = "airoha,an7583-pcie-gen3-phy";
			reg = <0x0 0x1fc7f000 0x0 0x1000>,
			      <0x0 0x1fc7e000 0x0 0x1000>,
			      <0x0 0x1fc10044 0x0 0x4>,
			      <0x0 0x1fc15030 0x0 0x4>;
			reg-names = "g3-ana", "g3-pma", "xr-dtime", "rx-aeq";
			#phy-cells = <0>;
			status = "okay";
		};

		pcie0: pcie@1fc20000 {
			compatible = "airoha,en7581-pcie";
			device_type = "pci";
			linux,pci-domain = <0>;
			#address-cells = <3>;
			#size-cells = <2>;

			reg = <0x0 0x1fc20000 0x0 0x20000>;
			reg-names = "pcie-mac";

			clocks = <&scuclk EN7523_CLK_PCIE>;
			clock-names = "sys-ck";

			pinctrl-names = "default";
			pinctrl-0 = <&pcie0_rst_pins>;

			phys = <&pciephy>;
			phy-names = "pcie-phy";

			resets = <&scuclk AN7583_PCIE0_RST>;
			reset-names = "phy-lane0";

			ranges = <0x02000000 0 0x20000000 0x0 0x20000000 0 0x4000000>;

			mediatek,pbus-csr = <&pbus_csr 0x0 0x4>;

			interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
			bus-range = <0x00 0xff>;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &pcie_intc0 0>,
					<0 0 0 2 &pcie_intc0 1>,
					<0 0 0 3 &pcie_intc0 2>,
					<0 0 0 4 &pcie_intc0 3>;

			status = "okay";

			pcie_intc0: interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
			};

			pcie@0,0 {
				reg = <0x0000 0 0 0 0>;
				#address-cells = <3>;
				#size-cells = <2>;
				ranges;

				wifi@0,0 {
					reg = <0x0000 0 0 0 0>;
				};
			};
		};

		pcie1: pcie@1fa92000 {
			compatible = "airoha,en7523-pcie", "mediatek,mt7622-pcie";
			device_type = "pci";
			linux,pci-domain = <1>;
			#address-cells = <3>;
			#size-cells = <2>;

			reg = <0x0 0x1fa92000 0x0 0x1000>;
			reg-names = "port1";

			clocks = <&scuclk EN7523_CLK_PCIE>;
			clock-names = "sys_ck1";

			pinctrl-names = "default";
			pinctrl-0 = <&pcie1_rst_pins>;

			resets = <&scuclk AN7583_PCIE1_RST>;
			reset-names = "pcie-rst1";

			ranges = <0x82000000 0 0x24000000 0x0 0x24000000 0 0x4000000>;

			mediatek,pbus-csr = <&pbus_csr 0x8 0xc>;

			interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "pcie_irq";
			bus-range = <0x00 0xff>;
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &pcie_intc1 0>,
					<0 0 0 2 &pcie_intc1 1>,
					<0 0 0 3 &pcie_intc1 2>,
					<0 0 0 4 &pcie_intc1 3>;

			status = "okay";

			pcie_intc1: interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
			};

			pcie@0,0 {
				reg = <0x0000 0 0 0 0>;
				#address-cells = <3>;
				#size-cells = <2>;
				ranges;

				wifi@0,0 {
					reg = <0x0000 0 0 0 0>;
					nvmem-cells = <&macaddr_art_0>, <&cal_art_40000>;
					nvmem-cell-names = "mac-address", "eeprom";
				};
			};
		};
	};
};
